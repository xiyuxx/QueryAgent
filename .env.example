# QueryAgent local Web Demo configuration
# Copy this file to .env before starting Docker Compose:
#   cp .env.example .env
# Fill at least one real model API key. Never commit .env.

# The initially selected provider. The UI exposes only providers with a key.
QUERYAGENT_PROVIDER=deepseek

# DeepSeek (OpenAI-compatible API)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Qwen / Alibaba Cloud Model Studio (OpenAI-compatible API)
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# OpenAI (OpenAI-compatible API)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# PostgreSQL used by the Docker Compose services.
POSTGRES_DB=queryagent_demo
POSTGRES_USER=queryagent
POSTGRES_PASSWORD=change-me-before-sharing
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Internal service settings. The browser must not receive these values.
QUERYAGENT_DB_DSN=postgresql://queryagent:change-me-before-sharing@postgres:5432/queryagent_demo
QUERYAGENT_DEFAULT_ROLE=readonly
QUERYAGENT_MAX_ROWS=100
QUERYAGENT_STATEMENT_TIMEOUT_MS=5000
QUERYAGENT_AUDIT_LOG=/var/lib/queryagent/audit.jsonl

# Local embedding model. The first initialization downloads it into the
# persistent Docker cache; later starts reuse the cache.
QUERYAGENT_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
QUERYAGENT_EMBEDDING_CACHE=/root/.cache/fastembed
QUERYAGENT_EMBEDDING_DIM=512

# Frontend/backend ports are only published on the local machine.
QUERYAGENT_FRONTEND_PORT=5173
QUERYAGENT_BACKEND_PORT=8000
